DATABASE_URL="mysql://inventory:inventory@localhost:3306/inventory"
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_USER="inventory"
DATABASE_PASSWORD="inventory"
DATABASE_NAME="inventory"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Optional HTTP Basic Auth gate for LAN/server access.
# When both are set, browsers must authenticate before staff login.
# Leave unset for local development without the Basic Auth prompt.
BASIC_AUTH_USER="inventory"
BASIC_AUTH_PASSWORD="your-password-here"
