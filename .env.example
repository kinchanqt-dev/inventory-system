# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Optional: only needed for admin scripts / platform console (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Comma-separated emails promoted to SUPER_ADMIN on login (requires service role key)
# PLATFORM_ADMIN_EMAILS="hello@kinchan.is-a.dev"

# Optional: Postgres URI for CLI/psql migrations (Connect → URI → Direct).
# If the DB password has special characters (@ ? * # / etc), percent-encode it.
# Example raw password  p@ss? →  p%40ss%3F
# DATABASE_URL="postgresql://postgres:ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
